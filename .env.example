# Discord Bot Configuration
DISCORD_TOKEN=your_discord_token_here
PREFIX=!

# Spotify Configuration (Required for Spotify links)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Genius Configuration (Optional for lyrics)
GENIUS_ACCESS_TOKEN=your_genius_access_token

# Lavalink Configuration
# Set to false to save ~500MB RAM by using only public nodes
USE_LOCAL_LAVALINK=true

# Performance & Stability
# Set to true to enable aggressive node health checks to mitigate BPM jitter
STABILITY_MODE=false

# Dashboard Configuration
PORT=3000
DASHBOARD_PORT=3000
